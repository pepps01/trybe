# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app,
# so only put public addresses here — never secrets.

# Trybe API origin (HTTPS, no path). Requests go to <origin>/api/v1/...
EXPO_PUBLIC_API_ORIGIN=https://api.example.org

# Optional: Trybe Identity origin. When set, sign-in refuses to open any
# authorization page that isn't on this origin.
EXPO_PUBLIC_IDENTITY_ORIGIN=https://identity.example.org
